# Docker Compose settings
NGINX_PORT=80
MYSQL_PORT=3306
PHPMYADMIN_PORT=8088
MAILPIT_HTTP_PORT=8025
MAILPIT_SMTP_PORT=1025
SWAGGER_UI_PORT=8000
BAIKAL_PORT=8100
OPENLDAP_PORT=389
OPENLDAP_SSL_PORT=636
PHPLDAPADMIN_PORT=8200
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Application
BASE_URL=http://localhost
DEFAULT_LANGUAGE=russian
DEBUG_MODE=false
APP_ENV=

# Database
DB_HOST=mysql
MYSQL_ROOT_PASSWORD=secret
MYSQL_DATABASE=cacaboo
MYSQL_USER=cacaboo
MYSQL_PASSWORD=cacaboo_pass
DB_PREFIX=ea_

# RabbitMQ
RABBITMQ_ENABLED=true
RABBITMQ_HOST=rabbitmq
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_QUEUE=notifications
RABBITMQ_EXCHANGE=notifications_exchange
RABBITMQ_ROUTING_KEY=notifications

# SMS service
#
# Which SMS provider to use for OUTGOING messages (the ones published to the
# sms queue by the app/reminder). Options:
#   keenetic - send through the Keenetic router / modem (no delivery status)
#   smsaero  - send through https://smsaero.ru (delivery status checked, the
#              notified/feedback message is only published on confirmed delivery)
#   smsru    - send through https://sms.ru (delivery status checked, the
#              notified/feedback message is only published on confirmed delivery)
#   routing  - Megafon numbers through Keenetic, all others through sms.ru.
#              The operator is resolved per number via SMS_MNO_LOOKUP_URL.
# Switch by changing this single value. Default: keenetic
SMS_PROVIDER=keenetic

# -- Provider: keenetic (router / modem) --
# To test against the built-in Keenetic mock instead of a real router set:
# MODEM_URL_BASE=http://keenetic-mock:8080
MODEM_NAME=UsbQmi0
MODEM_USER=samsa
MODEM_PASSWORD=samsa
MODEM_URL_BASE=http://192.168.0.1
KEENETIC_MOCK_PORT=18080

# Shared API key used by whichever gateway provider is active (SMS_PROVIDER):
#   - smsaero: the API key (Settings -> API) of the SMSAero account
#   - smsru:   the api_id (API key) from the sms.ru dashboard
SMS_GATE_API_KEY=

# Shared delivery-status polling interval (seconds) used by whichever gateway
# provider is active. How often to ask the gateway for the message status.
SMS_GATE_STATUS_POLL_INTERVAL=10

# Shared timeout (seconds) to wait for a delivery report before giving up.
SMS_GATE_STATUS_TIMEOUT=120

# Shared sender name ("from") used by whichever gateway provider is active:
#   - smsaero: the alpha sender name (sign), configured in the SMSAero account
#   - smsru:   the from field (agreed with the operator)
SMS_GATE_FROM=

# -- Provider: smsaero (https://smsaero.ru) --
# Login email for the SMSAero account.
SMSAERO_EMAIL=
# SMS channel (optional): DIGITAL / INTERNATIONAL / DIRECT / COURIER / HAU / BULK.
SMSAERO_CHANNEL=

# Cron expression for SMS polling from modem to Telegram (default: every minute)
SMS_POLL_CRON=* * * * *

# -- Provider: routing (Megafon -> Keenetic, others -> sms.ru) --
# BDPN service used to detect the phone operator of a number.
SMS_MNO_LOOKUP_URL=https://www.nic-t.ru/bdpn/bdpn-proverka-nomera/
# Timeout (seconds) for a single operator-lookup request.
SMS_MNO_LOOKUP_TIMEOUT=15
# SMS from this sender containing any of these keywords (comma-separated) are ignored
SMS_IGNORE_SENDER=MegaFon
SMS_IGNORE_KEYWORDS=код подтверждения,код для входа,ваш код

# SMS feedback queue (published after a successful SMS send)
RABBITMQ_NOTIFIED_QUEUE=notified
RABBITMQ_NOTIFIED_EXCHANGE=notified_exchange
RABBITMQ_NOTIFIED_ROUTING_KEY=notified
# Queue where SMS that hit a transient gateway limit are moved (e.g. sms.ru
# code 232 "daily limit of identical messages"), to be retried later instead
# of retried immediately / lost.
SMS_DELAYED_QUEUE=sms_delayed
# Concurrency: number of worker threads for sending SMS and for polling
# delivery status. All messages are drained from the queue and processed
# across these threads.
SMS_SEND_WORKERS=4
SMS_STATUS_WORKERS=4
# How often (seconds) the service re-checks the queue for new messages.
SMS_DRAIN_INTERVAL=1.0
# Keep the worker's RabbitMQ connection alive through idle/NAT timeouts (seconds).
RABBITMQ_HEARTBEAT=60

# Google Calendar (optional, can also be configured via the admin UI)
GOOGLE_SYNC_FEATURE=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Reminder worker
WORKER_POLL_INTERVAL=60
WORKER_REMINDER_OFFSETS=7,3,1
WORKER_TOLERANCE_SECONDS=120
WORKER_TIMEZONE=Europe/Moscow
WORKER_TYPE=appointment_reminder
WORKER_SUBJECT=Напоминание о записи на СТО
REMINDER_STATUS_NOTIFIED=Оповещен
REMINDER_STATUS_ERROR=Ошибка
# Only reminders sent this many day(s) ahead set the "Оповещен" status
REMINDER_STATUS_OFFSET=1
REMINDER_PHONE_PREFIX=+7
ADDRESS=Пушкина,19
CONTACT_PHONE=+74955554433
# Telegram notifications for invalid phone numbers (bot token and channel/chat id)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
# Optional HTTP(S) proxy for reaching Telegram, e.g. http://proxy:3128
TELEGRAM_PROXY=

# Backup worker (daily MySQL dump uploaded to a Windows SMB share)
BACKUP_TIME=02:00
BACKUP_RETENTION_DAYS=30
BACKUP_RUN_ON_START=false
BACKUP_NAME_PREFIX=cacaboo
# Windows share settings (e.g. //192.168.1.10/backups, path /daily)
SMB_HOST=
SMB_PORT=445
SMB_SHARE=
SMB_PATH=/
SMB_USERNAME=
SMB_PASSWORD=
SMB_PROTOCOL=SMB3