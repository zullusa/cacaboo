# Provider name (metrics label for this modem worker). Also the "provider"
# routing key this instance reacts to: only forwarded messages stamped with
# this provider (PROVIDER_FILTER) are delivered, everything else is requeued
# for the instance that owns it.
PROVIDER=name
PROVIDER_FILTER=name

# A message whose provider does not match PROVIDER_FILTER is requeued up to
# MAX_REQUEUE times to give the right instance a chance to pick it up, then
# dropped to avoid livelock when no matching instance is running.
MAX_REQUEUE=10

MODEM_NAME=UsbLte0
MODEM_USER=samsa
MODEM_PASSWORD=samsa
MODEM_URL_BASE=http://192.168.0.1

# Modem worker metrics endpoint (host port mapped in docker-compose.local.yaml)
METRICS_PORT=8004

# RabbitMQ
RABBITMQ_ENABLED=true
RABBITMQ_HOST=queue.server
RABBITMQ_USER=user
RABBITMQ_PASSWORD=pass
RABBITMQ_VHOST=/
# Shared provider queue: sms-service forwards all routed providers here
# (SMS_FORWARD_QUEUE=notifications_others) and stamps each message with a
# "provider" routing key; this instance delivers only its own (PROVIDER_FILTER).
RABBITMQ_QUEUE=_others
RABBITMQ_EXCHANGE=s_exchange_others
RABBITMQ_ROUTING_KEY=_others
# SMS feedback queue (published after a successful SMS send)
RABBITMQ_NOTIFIED_QUEUE=notified_dev
RABBITMQ_NOTIFIED_EXCHANGE=notified_exchange_dev
RABBITMQ_NOTIFIED_ROUTING_KEY=notified_dev

# Telegram notifications for invalid phone numbers (bot token and channel/chat id)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
# Optional HTTP(S) proxy for reaching Telegram, e.g. http://proxy:3128
TELEGRAM_PROXY=
SMS_POLL_INTERVAL_SECONDS=60
SMS_IGNORE_SENDER=Beeline
SMS_IGNORE_KEYWORDS=код подтверждения,код для входа,ваш код
